# Local development only. Copy to .env and replace the example passwords.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=trade_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=trade_intel
DATABASE_URL=postgresql://trade_app:replace-with-a-local-password@postgres:5432/trade_intel
REDIS_URL=redis://redis:6379
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-local-password
