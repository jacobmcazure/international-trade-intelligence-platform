# Copy this file to .env.production.local (which is gitignored) on the server.
# Public hostname pointed at this server. Caddy obtains and renews TLS automatically.
DOMAIN=trade.example.com
RELEASE_TAG=initial-2026-09-14

# Use a dedicated role and a long random alphanumeric password. This avoids
# accidental Compose interpolation of characters such as "$".
POSTGRES_USER=trade_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=trade_intel

# Required only while running the annual bilateral-trade ETL job.
UN_COMTRADE_DB_API_KEY=
